<odoo>
    <data noupdate="1">
        <record id="module_category_aam_hospital" model="ir.module.category">
            <field name="name">Hospital</field>
            <field name="description">Gestión hospitalaria</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_aam_medico" model="res.groups">
            <field name="name">Médico</field>
            <field name="category_id" ref="module_category_aam_hospital"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_aam_enfermero" model="res.groups">
            <field name="name">Enfermero</field>
            <field name="category_id" ref="module_category_aam_hospital"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_aam_auxiliar" model="res.groups">
            <field name="name">Auxiliar de Enfermería</field>
            <field name="category_id" ref="module_category_aam_hospital"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_aam_tecnico" model="res.groups">
            <field name="name">Técnico Informático</field>
            <field name="category_id" ref="module_category_aam_hospital"/>
            <field name="implied_ids" eval="[(4, ref('base.group_erp_manager'))]"/>
        </record>
        <record id="group_aam_administracion" model="res.groups">
            <field name="name">Administración</field>
            <field name="category_id" ref="module_category_aam_hospital"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
