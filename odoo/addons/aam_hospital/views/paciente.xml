<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="aam_hospital.paciente_tree" model="ir.ui.view">
            <field name="name">aam_hospital.paciente.tree</field>
            <field name="model">aam_hospital.paciente</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="nip"/>
                    <field name="nombre"/>
                    <field name="apellido1"/>
                    <field name="apellido2"/>
                    <field name="fecha_nacimiento"/>
                    <field name="fecha_ingreso"/>
                    <field name="fecha_alta"/>
                    <field name="genero"/>
                    <field name="direccion"/>
                    <field name="ciudad"/>
                    <field name="codigo_postal"/>
                    <field name="telefono"/>
                    <field name="email"/>
                    <field name="historial_medico"/>
                    <field name="movilidad"/>
                    <field name="alergias"/>
                    <field name="aislamiento"/>
                </tree>
            </field>
        </record>
        <record id="aam_hospital.paciente_form" model="ir.ui.view">
            <field name="name">aam_hospital.paciente.form</field>
            <field name="model">aam_hospital.paciente</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="nip"/>
                            <field name="nombre"/>
                            <field name="apellido1"/>
                            <field name="apellido2"/>
                            <field name="genero"/>
                            <field name="fecha_nacimiento"/>
                        </group>
                        <group string="Contacto">
                            <field name="direccion"/>
                            <field name="ciudad"/>
                            <field name="codigo_postal"/>
                            <field name="telefono"/>
                            <field name="email"/>
                        </group>
                        <group string="Fechas">
                            <field name="fecha_ingreso"/>
                            <field name="fecha_alta"/>
                        </group>
                         <group string="Información médica">
                            <field name="historial_medico"/>
                            <field name="movilidad"/>
                            <field name="alergias"/>
                            <field name="aislamiento"/>
                        </group>
                        <group string="Departamentos asignados"> 
                            <field name="departamento_ids" widget="many2many_tags"/> 
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="aam_hospital.paciente_kanban" model="ir.ui.view">
            <field name="name">aam_hospital.paciente.kanban</field>
            <field name="model">aam_hospital.paciente</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_small_column">
                    <field name="nip"/>
                    <field name="nombre"/>
                    <field name="apellido1"/>
                    <field name="apellido2"/>
                    <field name="genero"/>
                    <field name="fecha_ingreso"/>
                    <field name="movilidad"/>
                    <field name="aislamiento"/>

                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_kanban_card">
                                <div class="o_kanban_details">

                                    
                                    <strong class="o_kanban_record_title">
                                        <t t-esc="record.nombre.value"/> 
                                        <t t-esc="record.apellido1.value"/> 
                                        <t t-if="record.apellido2.value">
                                            <t t-esc="record.apellido2.value"/>
                                        </t>
                                    </strong>



                                    
                                    <div class="text-muted">
                                        NIP: <t t-esc="record.nip.value"/>
                                    </div>

                                    
                                    <div>
                                        <span class="text-muted">Género:</span>
                                        <t t-esc="record.genero.value"/>
                                    </div>

                                   
                                    <div>
                                        <span class="text-muted">Ingreso:</span>
                                        <t t-esc="record.fecha_ingreso.value"/>
                                    </div>

                                    
                                    <div class="mt8">
                                        <t t-if="record.movilidad.value">
                                             Movilidad reducida
                                        </t>
                                    </div>

                                    <div>
                                        <t t-if="record.aislamiento.value">
                                             Aislamiento
                                        </t>
                                    </div>

                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <record id="aam_hospital.paciente_calendar" model="ir.ui.view">
            <field name="name">aam_hospital.paciente.calendar</field>
            <field name="model">aam_hospital.paciente</field>
            <field name="arch" type="xml">
                <calendar string="Calendario de Ingresos y Altas"
                        date_start="fecha_ingreso"
                        date_stop="fecha_alta">
                    <field name="nombre"/>
                    <field name="fecha_ingreso"/>
                    <field name="fecha_alta"/>
                </calendar>
            </field>
        </record>
        <record id="aam_hospital.paciente_pivot" model="ir.ui.view">
            <field name="name">aam_hospital.paciente.pivot</field>
            <field name="model">aam_hospital.paciente</field>
            <field name="arch" type="xml">
                <pivot>
                    <field name="genero" type="row"/>
                    <field name="movilidad" type="row"/>
                    <field name="aislamiento" type="col"/>
                    <field name="departamento_ids" type="row"/>
                    <field name="id_habitacion" type="col"/>
                    <field name="ciudad" type="row"/>
                    <field name="fecha_ingreso" interval="month" type="col"/>
                </pivot>
            </field>
        </record>


        
    </data>
</odoo>