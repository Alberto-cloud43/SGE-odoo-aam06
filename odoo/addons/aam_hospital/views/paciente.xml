<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="aam_hospital.paciente_tree" model="ir.ui.view">
            <field name="name">aam_hospital.paciente.tree</field>
            <field name="model">aam_hospital.paciente</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="nip"/>
                    <field name="nombre"/>
                    <field name="apellido1"/>
                    <field name="apellido2"/>
                    <field name="fecha_nacimiento"/>
                    <field name="fecha_ingreso"/>
                    <field name="fecha_alta"/>
                    <field name="genero"/>
                    <field name="direccion"/>
                    <field name="ciudad"/>
                    <field name="codigo_postal"/>
                    <field name="telefono"/>
                    <field name="email"/>
                    <field name="historial_medico"/>
                    <field name="movilidad"/>
                    <field name="alergias"/>
                    <field name="aislamiento"/>
                </tree>
            </field>
        </record>
        <record id="aam_hospital.paciente_form" model="ir.ui.view">
            <field name="name">aam_hospital.paciente.form</field>
            <field name="model">aam_hospital.paciente</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="nip"/>
                            <field name="nombre"/>
                            <field name="apellido1"/>
                            <field name="apellido2"/>
                            <field name="genero"/>
                            <field name="fecha_nacimiento"/>
                        </group>
                        <group string="Contacto">
                            <field name="direccion"/>
                            <field name="ciudad"/>
                            <field name="codigo_postal"/>
                            <field name="telefono"/>
                            <field name="email"/>
                        </group>
                        <group string="Fechas">
                            <field name="fecha_ingreso"/>
                            <field name="fecha_alta"/>
                        </group>
                         <group string="Información médica">
                            <field name="historial_medico"/>
                            <field name="movilidad"/>
                            <field name="alergias"/>
                            <field name="aislamiento"/>
                        </group>
                        <group string="Departamentos asignados"> 
                            <field name="departamento_ids" widget="many2many_tags"/> 
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>