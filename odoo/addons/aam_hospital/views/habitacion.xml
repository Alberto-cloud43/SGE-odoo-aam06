<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

       
        <record id="aam_hospital.habitacion_tree" model="ir.ui.view">
            <field name="name">aam_hospital.habitacion.tree</field>
            <field name="model">aam_hospital.habitacion</field>
            <field name="arch" type="xml">
                <tree string="Habitaciones">
                    <field name="numero_habitacion"/>
                    <field name="tipo_habitacion"/>
                    <field name="planta"/>
                    <field name="estado"/>
                </tree>
            </field>
        </record>


        <record id="aam_hospital.habitacion_form" model="ir.ui.view">
            <field name="name">aam_hospital.habitacion.form</field>
            <field name="model">aam_hospital.habitacion</field>
            <field name="arch" type="xml">
                <form string="Habitación">
                    <sheet>
                        <group>
                            <field name="numero_habitacion"/>
                            <field name="tipo_habitacion"/>
                            <field name="planta"/>
                            <field name="estado"/>
                        </group>

                        <group>
                            <field name="id_paciente">
                                <tree editable="top">
                                    <field name="nip"/> 
                                        <field name="nombre"/> 
                                        <field name="apellido1"/> 
                                        <field name="apellido2"/> 
                                        <field name="fecha_nacimiento"/> 
                                        <field name="fecha_ingreso"/> 
                                        <field name="genero"/> 
                                        <field name="direccion"/> 
                                        <field name="ciudad"/> 
                                        <field name="codigo_postal"/> 
                                        <field name="telefono"/> 
                                        <field name="email"/> 
                                        <field name="movilidad"/> 
                                        <field name="alergias"/> 
                                        <field name="aislamiento"/>
                                </tree>
                                <form>
                                    <group>
                                        <field name="nip"/> 
                                        <field name="nombre"/> 
                                        <field name="apellido1"/> 
                                        <field name="apellido2"/> 
                                        <field name="fecha_nacimiento"/> 
                                        <field name="fecha_ingreso"/> 
                                        <field name="genero"/> 
                                        <field name="direccion"/> 
                                        <field name="ciudad"/> 
                                        <field name="codigo_postal"/> 
                                        <field name="telefono"/> 
                                        <field name="email"/> 
                                        <field name="movilidad"/> 
                                        <field name="alergias"/> 
                                        <field name="aislamiento"/>
                                    </group>
                                </form>
                            </field>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>
        <record id="aam_hospital.habitacion_kanban" model="ir.ui.view">
            <field name="name">aam_hospital.habitacion.kanban</field>
            <field name="model">aam_hospital.habitacion</field>
            <field name="arch" type="xml">
                <kanban default_group_by="estado" class="o_kanban_small_column">
                    <field name="numero_habitacion"/>
                    <field name="tipo_habitacion"/>
                    <field name="planta"/>
                    <field name="estado"/>

                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_kanban_card">
                                <div class="o_kanban_details">

                                    <strong class="o_kanban_record_title">
                                        Habitación <t t-esc="record.numero_habitacion.value"/>
                                    </strong>

                                    <div>
                                        <span class="text-muted">Tipo:</span>
                                        <t t-esc="record.tipo_habitacion.value"/>
                                    </div>

                                    <div>
                                        <span class="text-muted">Planta:</span>
                                        <t t-esc="record.planta.value"/>
                                    </div>

                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


    </data>
</odoo>
