<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="aam_hospital.departamento_tree" model="ir.ui.view">
            <field name="name">aam_hospital.departamento.tree</field>
            <field name="model">aam_hospital.departamento</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="id_departamento"/>
                    <field name="especialidad"/>
                    <field name="telefono_guardia"/>
                    <field name="numero_despacho"/>
                </tree>
            </field>
        </record>
        <record id="aam_hospital.departamento_form" model="ir.ui.view">
            <field name="name">aam_hospital.departamento.form</field>
            <field name="model">aam_hospital.departamento</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="id_departamento"/>
                            <field name="especialidad"/>
                            <field name="telefono_guardia"/>
                            <field name="numero_despacho"/>
                        </group>

                        <group>
                            <field name="descripcion"/>
                        </group>
                        <group string="Pacientes asignados">
                            <field name="paciente_ids"> 
                                <tree> 
                                    <field name="nombre"/> 
                                    <field name="apellido1"/> 
                                    <field name="apellido2"/>
                                    <field name="fecha_ingreso"/> 
                                    <field name="telefono"/> 
                                    <field name="email"/> 
                                </tree>
                            </field>
                        </group>
                        <group string="Medicos asignados">
                            <field name="medico_ids"> 
                                <tree> 
                                    <field name="numero_colegiado"/>
                                    <field name="nombre_medico"/> 
                                    <field name="apellido_medico_1"/> 
                                    <field name="apellido_medico_2"/>
                                    <field name="email"/> 
                                    <field name="telefono"/>  
                                </tree>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="aam_hospital.departamento_kanban" model="ir.ui.view">
            <field name="name">aam_hospital.departamento.kanban</field>
            <field name="model">aam_hospital.departamento</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="id_departamento"/>
                    <field name="especialidad"/>
                    <field name="telefono_guardia"/>
                    <field name="numero_despacho"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card">
                                <strong>Departamento: </strong>
                                <span><t t-esc="record.especialidad.value"/></span>
                                <br/>
                                <strong>Teléfono de Guardia: </strong>
                                <span><t t-esc="record.telefono_guardia.value"/></span>
                                <br/>
                                <strong>Número de Despacho: </strong>
                                <span><t t-esc="record.numero_despacho.value"/></span>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

    </data>
</odoo>
